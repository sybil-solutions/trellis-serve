// Inkling 2 (Inkling-2-Mini) routed-expert kernels for Intel Xe3 (Arc B390): the checkpoint's native formats.
//
// NVFP4 (layers 0-19):  w uint8 [E][N][K/2] (low nibble = even column), scale e4m3 [E][N][K/16], alpha[e] fp32
// MXFP8 (layers 20-23): w e4m3  [E][N][K],                              scale e8m0 [E][N][K/32]
//
// moe_gemv: decode / verify. Pairs (token, slot) arrive sorted by expert and padded to MB per expert block
//   (sorted[blk*MB + r] = pair id, >= n_pairs = pad; eob[blk] = expert or -1). One work-group = (expert block, 64 rows):
//   16 sub-groups x 4 rows; in each row every lane owns one 16-element scale group per step (8 B NVFP4 / 16 B MXFP8),
//   decodes it through a 256-entry SLM table (byte -> half2 / half) and keeps MB accumulators; sub-group reduce at the end.
//   out[pair][n] = alpha * sum_k W[n][k] * A[pair / a_row_div][k]  (* topw[pair] if given)
// dequant: whole experts -> bf16 [E][N][K] for the prefill GEMMs.
#include <torch/all.h>
#include <torch/library.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>

namespace inkling2 {
using bf16 = sycl::ext::oneapi::bfloat16;
using half = sycl::half;

static sycl::queue& queue_of(const at::Tensor& t) { return c10::xpu::getCurrentXPUStream(t.device().index()).queue(); }

static inline float e2m1(int q) {
    int e = (q >> 1) & 3, m = q & 1;
    int mag2 = e ? ((2 | m) << (e - 1)) : m;           // value * 2
    float f = 0.5f * (float)mag2;
    return (q & 8) ? -f : f;
}
static inline float e4m3(int b) {
    int e = (b >> 3) & 15, m = b & 7;
    float f = e ? sycl::ldexp(1.0f + m * 0.125f, e - 7) : m * 0.001953125f;
    return (b & 128) ? -f : f;
}

constexpr int SG = 16;
constexpr int NSG = 16;            // sub-groups per work-group
constexpr int RPS = 4;             // rows per sub-group
constexpr int ROWS = NSG * RPS;    // rows per work-group

// FMT: 0 = NVFP4, 1 = MXFP8, 2 = Q8 (int8 [N][K], fp16 scale per 32)
template <int MB, int FMT>
static void moe_gemv_impl(sycl::queue& q, const bf16* A, const uint8_t* W, const uint8_t* S, const float* alpha,
                          float* out, const int* sorted, const int* eob, const float* topw, int n_blocks, int n_pairs,
                          int N, int K, int a_row_div, int64_t lda, int64_t sw_e, int64_t sw_n, int64_t ss_e, int64_t ss_n) {
    const int n_tiles = (N + ROWS - 1) / ROWS;
    constexpr bool NV = FMT == 0;
    const int groups = K / 16;   // lane step = 16 elements in every format
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<sycl::half2, 1> lut2(sycl::range<1>(256), h);
        sycl::local_accessor<half, 1> lut1(sycl::range<1>(256), h);
        h.parallel_for(sycl::nd_range<1>((size_t)n_blocks * n_tiles * NSG * SG, NSG * SG),
                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
            const int lid = it.get_local_id(0);
            if (FMT == 0) lut2[lid] = sycl::half2(half(e2m1(lid & 15)), half(e2m1(lid >> 4)));
            else if (FMT == 1) lut1[lid] = half(e4m3(lid));
            it.barrier(sycl::access::fence_space::local_space);
            const int wg = it.get_group(0);
            const int blk = wg / n_tiles, tile = wg % n_tiles;
            const int e = eob[blk];
            if (e < 0) return;
            auto sg = it.get_sub_group();
            const int lane = sg.get_local_id()[0], sgi = sg.get_group_id()[0];
            int pr[MB]; const bf16* arow[MB]; bool live[MB];
#pragma unroll
            for (int r = 0; r < MB; ++r) {
                pr[r] = sorted[blk * MB + r];
                live[r] = pr[r] < n_pairs;
                arow[r] = A + (int64_t)(live[r] ? pr[r] / a_row_div : 0) * lda;
            }
            const float al = alpha ? alpha[e] : 1.0f;
            for (int rr = 0; rr < RPS; ++rr) {
                const int n = tile * ROWS + sgi * RPS + rr;
                if (n >= N) break;
                const uint8_t* wrow = W + e * sw_e + (int64_t)n * sw_n;
                const uint8_t* srow = S + e * ss_e + (int64_t)n * ss_n;
                float acc[MB];
#pragma unroll
                for (int r = 0; r < MB; ++r) acc[r] = 0.f;
                for (int g = lane; g < groups; g += SG) {
                    float sc;
                    float w[16];
                    if (NV) {
                        sc = e4m3(srow[g]);
                        const sycl::vec<uint8_t, 8> b = *reinterpret_cast<const sycl::vec<uint8_t, 8>*>(wrow + g * 8);
#pragma unroll
                        for (int j = 0; j < 8; ++j) { sycl::half2 p = lut2[b[j]]; w[2 * j] = p[0]; w[2 * j + 1] = p[1]; }
                    } else if (FMT == 1) {
                        sc = sycl::ldexp(1.0f, (int)srow[g >> 1] - 127);
                        const sycl::vec<uint8_t, 16> b = *reinterpret_cast<const sycl::vec<uint8_t, 16>*>(wrow + g * 16);
#pragma unroll
                        for (int j = 0; j < 16; ++j) w[j] = lut1[b[j]];
                    } else {
                        sc = (float)reinterpret_cast<const half*>(srow)[g >> 1];
                        const sycl::vec<int8_t, 16> b = *reinterpret_cast<const sycl::vec<int8_t, 16>*>(wrow + g * 16);
#pragma unroll
                        for (int j = 0; j < 16; ++j) w[j] = (float)b[j];
                    }
#pragma unroll
                    for (int r = 0; r < MB; ++r) {
                        if (!live[r]) continue;
                        const sycl::vec<uint16_t, 16> xv = *reinterpret_cast<const sycl::vec<uint16_t, 16>*>(arow[r] + g * 16);
                        float s = 0.f;
#pragma unroll
                        for (int j = 0; j < 16; ++j) s += w[j] * (float)sycl::bit_cast<bf16>((uint16_t)xv[j]);
                        acc[r] += s * sc;
                    }
                }
#pragma unroll
                for (int r = 0; r < MB; ++r) {
                    float v = sycl::reduce_over_group(sg, acc[r], sycl::plus<float>());
                    if (lane == 0 && live[r]) {
                        v *= al;
                        if (topw) v *= topw[pr[r]];
                        out[(int64_t)pr[r] * N + n] = v;
                    }
                }
            }
        });
    });
}

void moe_gemv(at::Tensor A, at::Tensor W, at::Tensor S, std::optional<at::Tensor> alpha, at::Tensor out,
              at::Tensor sorted, at::Tensor eob, std::optional<at::Tensor> topw, int64_t n_pairs, int64_t a_row_div, int64_t mb) {
    TORCH_CHECK(A.scalar_type() == at::kBFloat16 && A.stride(1) == 1, "A must be bf16 row-major");
    TORCH_CHECK(out.scalar_type() == at::kFloat && out.is_contiguous(), "out fp32 contiguous");
    const bool nv = W.size(2) * 2 == A.size(1);
    const int fmt = nv ? 0 : (W.scalar_type() == at::kChar ? 2 : 1);
    const int N = W.size(1), K = A.size(1);
    TORCH_CHECK(K % (fmt == 0 ? 16 : 32) == 0, "K must be a multiple of the scale group");
    auto& q = queue_of(A);
    const auto* a = reinterpret_cast<const bf16*>(A.data_ptr());
    const auto* w = reinterpret_cast<const uint8_t*>(W.data_ptr());
    const auto* s = reinterpret_cast<const uint8_t*>(S.data_ptr());
    const float* al = alpha ? alpha->data_ptr<float>() : nullptr;
    const float* tw = topw ? topw->data_ptr<float>() : nullptr;
    const int nb = eob.size(0);
#define CALL(MBV, NVV) moe_gemv_impl<MBV, NVV>(q, a, w, s, al, out.data_ptr<float>(), sorted.data_ptr<int>(), eob.data_ptr<int>(), tw, nb, \
        n_pairs, N, K, a_row_div, A.stride(0), W.stride(0), W.stride(1), S.stride(0) * S.element_size(), S.stride(1) * S.element_size())
    if (fmt == 0) { if (mb == 1) CALL(1, 0); else if (mb == 2) CALL(2, 0); else if (mb == 4) CALL(4, 0); else CALL(8, 0); }
    else if (fmt == 1) { if (mb == 1) CALL(1, 1); else if (mb == 2) CALL(2, 1); else if (mb == 4) CALL(4, 1); else CALL(8, 1); }
    else { if (mb == 1) CALL(1, 2); else if (mb == 2) CALL(2, 2); else if (mb == 4) CALL(4, 2); else CALL(8, 2); }
#undef CALL
}

// experts [E][N][K] -> bf16, for the selected expert ids (out [n_sel][N][K])
void dequant(at::Tensor W, at::Tensor S, std::optional<at::Tensor> alpha, at::Tensor ids, at::Tensor out) {
    const bool nv = W.size(2) * 2 == out.size(2);
    const int64_t N = W.size(1), K = out.size(2), nsel = ids.size(0);
    auto& q = queue_of(W);
    const auto* w = reinterpret_cast<const uint8_t*>(W.data_ptr());
    const auto* s = reinterpret_cast<const uint8_t*>(S.data_ptr());
    const float* al = alpha ? alpha->data_ptr<float>() : nullptr;
    const int* id = ids.data_ptr<int>();
    auto* o = reinterpret_cast<bf16*>(out.data_ptr());
    const int64_t sw_e = W.stride(0), sw_n = W.stride(1), ss_e = S.stride(0), ss_n = S.stride(1);
    const int64_t groups = nsel * N * (K / 16);
    q.parallel_for(sycl::range<1>(groups), [=](sycl::id<1> gi) {
        const int64_t g = gi[0];
        const int64_t kg = g % (K / 16), n = (g / (K / 16)) % N, i = g / (K / 16) / N;
        const int e = id[i];
        bf16* dst = o + (i * N + n) * K + kg * 16;
        if (nv) {
            const float sc = e4m3(s[e * ss_e + n * ss_n + kg]) * (al ? al[e] : 1.f);
            const uint8_t* b = w + e * sw_e + n * sw_n + kg * 8;
            for (int j = 0; j < 8; ++j) { dst[2 * j] = bf16(e2m1(b[j] & 15) * sc); dst[2 * j + 1] = bf16(e2m1(b[j] >> 4) * sc); }
        } else {
            const float sc = sycl::ldexp(1.0f, (int)s[e * ss_e + n * ss_n + kg / 2] - 127);
            const uint8_t* b = w + e * sw_e + n * sw_n + kg * 16;
            for (int j = 0; j < 16; ++j) dst[j] = bf16(e4m3(b[j]) * sc);
        }
    });
}


// ---- decode / verify attention (flash-decoding) ------------------------------------------------------------------
// One sub-group per (request b, kv head hk, split sp). Rows = G query heads x NQ query rows of the request.
// Phase 1 (lanes own keys): s[r] = scale * q_r . k_key + bias (table[row, h, dist] if dist < E), masked; online softmax.
// Phase 2 (lanes own 8 head dims): acc[r][8] += p[r][key] * v[key][lane dims] (p broadcast within the sub-group).
// Keys: PAGED -> pool row r2t[slot][j], position j, j < kvlen[b];  RING -> row slot*ring + j, position ring_pos[slot][j].
// Out: acc [T][H][NSPLIT][D], m/l [T][H][NSPLIT]; the sink logit enters split 0 as the initial (m, l) = (sink, 1).
template <int NQ, bool FP8, bool PAGED>
static void dec_attn_impl(sycl::queue& q, const bf16* Q, const uint8_t* K, const uint8_t* V, const int* slots, const int* kvlen,
                          const int* r2t, const int* rpos, const int* qpos_all, const bf16* table, const float* sink,
                          float* oacc, float* om, float* ol, int bs, int H, int Hkv, int nsplit, int ring, int window,
                          int E, int64_t sq_t, int64_t sq_h, int64_t sk_t, int64_t sk_h, int64_t sv_t, int64_t sv_h,
                          int64_t s_r2t, int64_t st_t, int64_t st_h, int64_t ss_t, int64_t ss_h, float scale, float kscale, float vscale) {
    constexpr int D = 128, DL = D / SG, G = 3, R = G * NQ;
    constexpr float NEG = -1e30f;
    q.submit([&](sycl::handler& h) {
        sycl::local_accessor<float, 1> qs(sycl::range<1>(R * D), h);
        sycl::local_accessor<half, 1> lut(sycl::range<1>(256), h);
        h.parallel_for(sycl::nd_range<1>((size_t)bs * Hkv * nsplit * SG, SG), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(SG)]] {
            auto sg = it.get_sub_group();
            const int lane = sg.get_local_id()[0];
            const int wg = it.get_group(0);
            const int b = wg / (Hkv * nsplit), hk = (wg / nsplit) % Hkv, sp = wg % nsplit;
            if (FP8) for (int i = lane; i < 256; i += SG) lut[i] = half(e4m3(i));
            for (int i = lane; i < R * D; i += SG) {
                const int r = i / D, d = i % D, gi = r / NQ, qi = r % NQ;
                qs[i] = (float)Q[(int64_t)(b * NQ + qi) * sq_t + (int64_t)(hk * G + gi) * sq_h + d] * scale;
            }
            sycl::group_barrier(it.get_group());
            const int64_t slot = slots[b];
            const int L = PAGED ? kvlen[b] : ring;
            int chunk = (L + nsplit - 1) / nsplit; chunk = (chunk + SG - 1) / SG * SG;
            const int lo = sp * chunk, hi = sycl::min(L, lo + chunk);
            int qpos[R]; float m[R], l[R], acc[R][DL];
#pragma unroll
            for (int r = 0; r < R; ++r) {
                const int gi = r / NQ, qi = r % NQ, row = b * NQ + qi, hh = hk * G + gi;
                qpos[r] = qpos_all[row];
                m[r] = sp == 0 ? sink[row * ss_t + hh * ss_h] : NEG;
                l[r] = sp == 0 ? 1.f : 0.f;
#pragma unroll
                for (int j = 0; j < DL; ++j) acc[r][j] = 0.f;
            }
            const int esz = FP8 ? 1 : 2;
            for (int start = lo; start < hi; start += SG) {
                const int key = start + lane;
                const bool kin = key < hi;
                int64_t loc = 0; int kpos = -1;
                if (kin) {
                    loc = PAGED ? (int64_t)r2t[slot * s_r2t + key] : slot * ring + key;
                    kpos = PAGED ? key : rpos[slot * ring + key];
                }
                float s[R];
#pragma unroll
                for (int r = 0; r < R; ++r) s[r] = 0.f;
                if (kin && kpos >= 0) {
                    const uint8_t* kr = K + (loc * sk_t + hk * sk_h) * esz;
#pragma unroll
                    for (int c = 0; c < D; c += 16) {
                        float kv[16];
                        if (FP8) {
                            const sycl::vec<uint8_t, 16> b8 = *reinterpret_cast<const sycl::vec<uint8_t, 16>*>(kr + c);
#pragma unroll
                            for (int j = 0; j < 16; ++j) kv[j] = (float)lut[b8[j]] * kscale;
                        } else {
                            const sycl::vec<uint16_t, 16> b16 = *reinterpret_cast<const sycl::vec<uint16_t, 16>*>(kr + 2 * c);
#pragma unroll
                            for (int j = 0; j < 16; ++j) kv[j] = (float)sycl::bit_cast<bf16>((uint16_t)b16[j]);
                        }
#pragma unroll
                        for (int r = 0; r < R; ++r) {
                            float t = 0.f;
#pragma unroll
                            for (int j = 0; j < 16; ++j) t += qs[r * D + c + j] * kv[j];
                            s[r] += t;
                        }
                    }
                }
                float p[R];
#pragma unroll
                for (int r = 0; r < R; ++r) {
                    const int gi = r / NQ, qi = r % NQ, row = b * NQ + qi, hh = hk * G + gi;
                    const int dist = qpos[r] - kpos;
                    const bool ok = kin && kpos >= 0 && dist >= 0 && (window == 0 || dist < window);
                    float sc = NEG;
                    if (ok) sc = s[r] + (dist < E ? (float)table[row * st_t + hh * st_h + dist] : 0.f);
                    const float bm = sycl::reduce_over_group(sg, sc, sycl::maximum<float>());
                    const float mn = sycl::fmax(m[r], bm);
                    if (mn <= NEG * 0.5f) { p[r] = 0.f; continue; }   // nothing valid yet (no infinities under -ffast-math)
                    const float alpha = sycl::exp(m[r] - mn);
                    p[r] = ok ? sycl::exp(sc - mn) : 0.f;
                    l[r] = l[r] * alpha + sycl::reduce_over_group(sg, p[r], sycl::plus<float>());
#pragma unroll
                    for (int j = 0; j < DL; ++j) acc[r][j] *= alpha;
                    m[r] = mn;
                }
                const int nk = sycl::min(SG, hi - start);
                for (int kk = 0; kk < nk; ++kk) {
                    const int64_t lk = sycl::group_broadcast(sg, loc, kk);
                    const uint8_t* vr = V + (lk * sv_t + hk * sv_h) * esz;
                    float vv[DL];
                    if (FP8) {
                        const sycl::vec<uint8_t, 8> b8 = *reinterpret_cast<const sycl::vec<uint8_t, 8>*>(vr + lane * DL);
#pragma unroll
                        for (int j = 0; j < DL; ++j) vv[j] = (float)lut[b8[j]] * vscale;
                    } else {
                        const sycl::vec<uint16_t, 8> b16 = *reinterpret_cast<const sycl::vec<uint16_t, 8>*>(vr + 2 * lane * DL);
#pragma unroll
                        for (int j = 0; j < DL; ++j) vv[j] = (float)sycl::bit_cast<bf16>((uint16_t)b16[j]);
                    }
#pragma unroll
                    for (int r = 0; r < R; ++r) {
                        const float pk = sycl::group_broadcast(sg, p[r], kk);
#pragma unroll
                        for (int j = 0; j < DL; ++j) acc[r][j] += pk * vv[j];
                    }
                }
            }
#pragma unroll
            for (int r = 0; r < R; ++r) {
                const int gi = r / NQ, qi = r % NQ, row = b * NQ + qi, hh = hk * G + gi;
                const int64_t o = ((int64_t)row * H + hh) * nsplit + sp;
#pragma unroll
                for (int j = 0; j < DL; ++j) oacc[o * D + lane * DL + j] = acc[r][j];
                if (lane == 0) { om[o] = m[r]; ol[o] = l[r]; }
            }
        });
    });
}

void decode_attn(at::Tensor Q, at::Tensor K, at::Tensor V, at::Tensor slots, std::optional<at::Tensor> kvlen,
                 std::optional<at::Tensor> r2t, std::optional<at::Tensor> rpos, at::Tensor qpos, at::Tensor table, at::Tensor sink,
                 at::Tensor oacc, at::Tensor om, at::Tensor ol, int64_t nq, int64_t ring, int64_t window, double kscale, double vscale) {
    TORCH_CHECK(Q.scalar_type() == at::kBFloat16 && table.scalar_type() == at::kBFloat16 && sink.scalar_type() == at::kFloat);
    TORCH_CHECK(Q.size(2) == 128 && Q.size(1) == 3 * K.size(1), "head_dim 128, GQA 3");
    const bool fp8 = K.element_size() == 1, paged = r2t.has_value();
    auto& q = queue_of(Q);
    const int bs = slots.size(0), H = Q.size(1), Hkv = K.size(1), nsplit = oacc.size(2), E = table.size(2);
    const float scale = 1.0f / sycl::sqrt(128.0f);
    const auto* Kp = reinterpret_cast<const uint8_t*>(K.data_ptr());
    const auto* Vp = reinterpret_cast<const uint8_t*>(V.data_ptr());
#define DA(NQV, F8, PG) dec_attn_impl<NQV, F8, PG>(q, reinterpret_cast<const bf16*>(Q.data_ptr()), Kp, Vp, slots.data_ptr<int>(), \
        PG ? kvlen->data_ptr<int>() : nullptr, PG ? r2t->data_ptr<int>() : nullptr, PG ? nullptr : rpos->data_ptr<int>(), qpos.data_ptr<int>(), \
        reinterpret_cast<const bf16*>(table.data_ptr()), sink.data_ptr<float>(), oacc.data_ptr<float>(), om.data_ptr<float>(), ol.data_ptr<float>(), \
        bs, H, Hkv, nsplit, (int)ring, (int)window, E, Q.stride(0), Q.stride(1), K.stride(0), K.stride(1), V.stride(0), V.stride(1), \
        PG ? r2t->stride(0) : 0, table.stride(0), table.stride(1), sink.stride(0), sink.stride(1), scale, (float)kscale, (float)vscale)
#define DA_NQ(F8, PG) if (nq == 1) DA(1, F8, PG); else if (nq == 2) DA(2, F8, PG); else if (nq <= 4) DA(4, F8, PG); else DA(8, F8, PG)
    TORCH_CHECK(nq == 1 || nq == 2 || nq == 4 || nq == 8, "nq in {1,2,4,8}");
    if (fp8) { if (paged) { DA_NQ(true, true); } else { DA_NQ(true, false); } }
    else { if (paged) { DA_NQ(false, true); } else { DA_NQ(false, false); } }
#undef DA_NQ
#undef DA
}

}  // namespace inkling2

TORCH_LIBRARY(inkling2_xpu, m) {
    m.def("moe_gemv(Tensor A, Tensor W, Tensor S, Tensor? alpha, Tensor(a!) out, Tensor sorted, Tensor eob, Tensor? topw, int n_pairs, int a_row_div, int mb) -> ()");
    m.impl("moe_gemv", torch::kXPU, &inkling2::moe_gemv);
    m.def("decode_attn(Tensor Q, Tensor K, Tensor V, Tensor slots, Tensor? kvlen, Tensor? r2t, Tensor? rpos, Tensor qpos, Tensor table, Tensor sink, Tensor(a!) oacc, Tensor(b!) om, Tensor(c!) ol, int nq, int ring, int window, float kscale, float vscale) -> ()");
    m.impl("decode_attn", torch::kXPU, &inkling2::decode_attn);
    m.def("dequant(Tensor W, Tensor S, Tensor? alpha, Tensor ids, Tensor(a!) out) -> ()");
    m.impl("dequant", torch::kXPU, &inkling2::dequant);
}
